VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# GTM. Keep EMPTY locally and in CI so dev clicks and tests never reach analytics.
# The real GTM-XXXXXXX lives only in the hosting dashboard (Production scope).
# The GTM snippet itself is added to the project separately.
VITE_GTM_ID=

# PostHog (optional, added separately). Same rule: empty locally and in CI.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# Test environment (for E2E tests)
# Copy to .env.test — only Supabase vars, NO tracking IDs!
# IMPORTANT: .env.test must NOT contain VITE_GTM_ID or VITE_POSTHOG_KEY
# to prevent E2E tests from polluting analytics.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=<local-anon-key-from-supabase-status>
# Public site URL, no trailing slash. Drives canonical URLs, og:url, sitemap.xml
# and robots.txt. Leave empty on preview/staging deploys: robots.txt then
# disallows indexing and no sitemap is generated.
VITE_SITE_URL=
